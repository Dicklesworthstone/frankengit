          "description": "RepositoryIncarnationConfigurationBody schema v2.0.",
          "type": "object",
          "additionalProperties": false,
          "required": ["variant", "discriminant", "body"],
          "properties": {
            "variant": { "const": "RepositoryIncarnationV2" },
            "discriminant": { "const": 2 },
