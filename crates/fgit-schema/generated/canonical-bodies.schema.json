              "type": "integer",
              "minimum": 0,
              "maximum": 65535,
              "description": "code point from the closed RefusalCode vocabulary"
            },
            "refusal_record_id": {
              "allOf": [{ "$ref": "#/$defs/DerivedId" }],
              "description": "domain-bound derived identity: frankengit/refusal-record/v1"
            }
          }
        }
      ]
    },
    "VerifiedReadConfiguration": {
      "description": "A version-tagged configuration body, inlined only when the answer needs one.",
      "oneOf": [
