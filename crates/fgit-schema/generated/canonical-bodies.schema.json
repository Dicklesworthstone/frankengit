{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frankengit.invalid/schemas/canonical-bodies.json",
  "title": "FrankenGit canonical bodies",
  "description": "GENERATED FILE - DO NOT EDIT.  Produced by `cargo run -p fgit-schema --bin fgit-schema-gen -- generate`. The generator is a repository-owned command: no build script, no proc macro, no network. `... -- check` refuses if this file differs from what the current descriptors produce, so an edit here fails the fast lane instead of drifting.",
  "$defs": {
    "Digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "bytes"],
      "properties": {
        "algorithm": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "bytes": { "type": "string", "pattern": "^[0-9a-f]{32,128}$" }
      }
    },
    "GitOid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "bytes"],
      "properties": {
        "algorithm": { "type": "integer", "minimum": 1, "maximum": 2 },
        "bytes": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" }
      }
    },
    "SchemaId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "major", "minor"],
      "properties": {
        "family": { "type": "string" },
        "major": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "minor": { "type": "integer", "minimum": 0, "maximum": 65535 }
      }
    },
    "DerivedId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "domain", "codec_major", "codec_minor", "digest"],
      "properties": {
        "algorithm": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "domain": { "type": "string" },
        "codec_major": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "codec_minor": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{32,128}$" }
      }
    },
    "RepositoryDecision": {
      "description": "One terminal decision within a batch, in the batch's own order.",
      "type": "object",
      "additionalProperties": false,
      "required": ["tx_id", "decision_sequence", "outcome"],
      "properties": {
        "tx_id": {
          "allOf": [{ "$ref": "#/$defs/DerivedId" }],
          "description": "domain-bound derived identity: frankengit/ref-txn/v2"
        },
        "decision_sequence": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "description": "u64 as a decimal string; outside the exact range of an IEEE-754 double"
        },
        "outcome": { "$ref": "#/$defs/DecisionOutcome" }
      }
    },
    "VerifiedReadMerkleProofPayload": {
      "description": "One native Merkle path, in the wire order consumed by the shared verifier.",
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "leaf_count"],
      "properties": {
        "index": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
