          "description": "u64 as a decimal string; outside the exact range of an IEEE-754 double"
        },
        "outcome": { "$ref": "#/$defs/DecisionOutcome" }
      }
    },
    "DecisionOutcome": {
      "description": "The terminal outcome of one decision: committed, or refused with a reason.",
      "oneOf": [
        {
          "description": "The decision committed, naming the record it produced.",
          "type": "object",
          "additionalProperties": false,
          "required": ["variant", "discriminant", "repository_commit_id"],
          "properties": {
            "variant": { "const": "Committed" },
            "discriminant": { "const": 1 },
