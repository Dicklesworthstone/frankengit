        {
          "description": "RepositoryIncarnationConfigurationBodyV2_1 schema v2.1, carrying the policy root.",
          "type": "object",
          "additionalProperties": false,
          "required": ["variant", "discriminant", "body"],
          "properties": {
            "variant": { "const": "RepositoryIncarnationV2_1" },
            "discriminant": { "const": 3 },
            "body": { "$ref": "#/$defs/RepositoryIncarnationConfigurationV21" }
          }
        }
      ]
    },
    "RefStateNonMembershipProof": {
      "description": "An absence proof selected by the requested name's ordered position.",
      "oneOf": [
        {
          "description": "The committed ref-state tree has no leaves.",
          "type": "object",
          "additionalProperties": false,
          "required": ["variant", "discriminant"],
          "properties": {
            "variant": { "const": "EmptyState" },
            "discriminant": { "const": 0 }
