        },
        "leaf_count": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "description": "u64 as a decimal string; outside the exact range of an IEEE-754 double"
        },
        "siblings": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]*$",
            "minLength": 32,
            "maxLength": 128
          }
        }
      }
    },
    "RefStateNeighbour": {
      "description": "One ordered ref-state neighbour and its membership path.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "oid", "proof"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[0-9a-f]*$",
          "minLength": 2,
          "maxLength": 2048
        },
        "oid": { "$ref": "#/$defs/GitOid" },
        "proof": { "$ref": "#/$defs/VerifiedReadMerkleProofPayload" }
      }
    },
    "RepositoryConfigurationV1": {
      "description": "Version-one repository configuration body carried inline by a verified read.",
      "type": "object",
      "additionalProperties": false,
      "required": ["root_layout", "object_format"],
      "properties": {
        "root_layout": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "code point from the closed RootLayoutVersion vocabulary"
        },
        "object_format": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "code point from the closed GitHashAlgorithm vocabulary"
        },
        "hidden_ref_rules": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]*$",
            "minLength": 0,
            "maxLength": 2048
