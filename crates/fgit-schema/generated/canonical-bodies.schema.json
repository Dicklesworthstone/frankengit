          "type": "object",
          "additionalProperties": false,
          "required": ["variant", "discriminant", "body"],
          "properties": {
            "variant": { "const": "RepositoryV1" },
            "discriminant": { "const": 1 },
            "body": { "$ref": "#/$defs/RepositoryConfigurationV1" }
