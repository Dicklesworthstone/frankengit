      "additionalProperties": false,
      "required": ["root_layout", "object_format", "repository_incarnation_id"],
      "properties": {
        "root_layout": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "code point from the closed RootLayoutVersion vocabulary"
        },
        "object_format": {
