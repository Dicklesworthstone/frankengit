            "body": {
              "type": "string",
              "description": "Issue body Markdown text (untrusted data).",
              "x-classification": "untrusted_content",
              "maxLength": 16384
            }
          },
          "required": ["number", "expected_version", "idempotency_key", "title", "body"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
