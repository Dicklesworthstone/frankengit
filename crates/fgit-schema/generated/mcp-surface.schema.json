              "type": "string",
              "description": "Exact predecessor version decimal string.",
              "x-classification": "selector_position",
              "maxLength": 20,
              "pattern": "^[0-9]+$"
            },
            "idempotency_key": {
              "type": "string",
              "description": "Durable printable ASCII idempotency key.",
              "x-classification": "selector_position",
              "maxLength": 256,
              "pattern": "^[!-~]+$"
            },
            "title": {
              "type": "string",
              "description": "Updated title (untrusted data).",
              "x-classification": "untrusted_content",
              "maxLength": 256
            },
            "body": {
              "type": "string",
              "description": "Updated body Markdown text (untrusted data).",
              "x-classification": "untrusted_content",
              "maxLength": 16384
            }
          },
          "required": ["number", "expected_version", "idempotency_key"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "frankengit_issue_list": {
      "title": "frankengit_issue_list",
