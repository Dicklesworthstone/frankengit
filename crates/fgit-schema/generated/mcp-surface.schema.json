              "x-classification": "selector_position",
              "maxLength": 20,
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "limit": {
              "type": "integer",
              "description": "Page item limit (1..20, default 5).",
              "x-classification": "selector_position"
            },
            "expected_head": {
              "type": "string",
              "description": "Exact snapshot token from first page.",
              "x-classification": "selector_position",
              "maxLength": 140
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "frankengit_issue_open": {
      "title": "frankengit_issue_open",
