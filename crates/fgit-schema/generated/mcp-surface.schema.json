    "frankengit_review_submit": {
      "title": "frankengit_review_submit",
      "description": "Submit a code review verdict binding exact candidate commit, tips, and policy epoch.",
      "type": "object",
      "properties": {
        "parameters": {
          "type": "object",
          "properties": {
            "number": {
              "type": "string",
