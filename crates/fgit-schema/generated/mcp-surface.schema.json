{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frankengit.invalid/schemas/mcp-surface.schema.json",
  "title": "FrankenGit Model Context Protocol (MCP) surface schema",
  "description": "Authoritative schema definitions for all FrankenGit MCP tools, resources, and prompts.",
  "type": "object",
  "properties": {
    "frankengit_admin_exec": {
      "title": "frankengit_admin_exec",
      "description": "Arbitrary command execution is constitutionally prohibited. Returns typed refusal.",
      "type": "object",
      "properties": {
        "parameters": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string",
              "description": "Attempted command string (prohibited).",
              "x-classification": "untrusted_content",
              "maxLength": 1024
            }
          },
          "required": ["command"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "frankengit_ambient_fs_read": {
      "title": "frankengit_ambient_fs_read",
      "description": "Ambient filesystem read outside admitted treefs workspaces is prohibited. Returns typed refusal.",
      "type": "object",
      "properties": {
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Attempted host filesystem path (prohibited).",
              "x-classification": "selector_position",
              "maxLength": 4096
            }
          },
          "required": ["path"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "frankengit_code_review_prompt": {
      "title": "frankengit_code_review_prompt",
      "description": "Prompt template for guiding AI agents through capability-narrow pull request review.",
      "type": "object",
      "properties": {
        "parameters": {
          "type": "object",
          "properties": {
            "pull_number": {
              "type": "string",
              "description": "Positive decimal pull request number.",
              "x-classification": "selector_position",
              "maxLength": 20,
              "pattern": "^[1-9][0-9]*$"
            }
          },
          "required": ["pull_number"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "frankengit_hidden_repair": {
      "title": "frankengit_hidden_repair",
      "description": "Silent repair or bypass of current authority head is constitutionally prohibited. Returns typed refusal.",
      "type": "object",
      "properties": {
        "parameters": {
          "type": "object",
          "properties": {
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "frankengit_issue_close": {
      "title": "frankengit_issue_close",
      "description": "Close an open issue with an exact predecessor version pin and durable idempotency key.",
      "type": "object",
      "properties": {
        "parameters": {
          "type": "object",
          "properties": {
            "number": {
              "type": "string",
              "description": "Positive decimal issue number.",
              "x-classification": "selector_position",
              "maxLength": 20,
              "pattern": "^[1-9][0-9]*$"
            },
            "expected_version": {
              "type": "string",
              "description": "Exact predecessor version decimal string.",
              "x-classification": "selector_position",
              "maxLength": 20,
              "pattern": "^[0-9]+$"
            },
            "idempotency_key": {
              "type": "string",
              "description": "Durable printable ASCII idempotency key.",
              "x-classification": "selector_position",
              "maxLength": 256,
              "pattern": "^[!-~]+$"
            }
          },
          "required": ["number", "expected_version", "idempotency_key"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "frankengit_issue_comment": {
      "title": "frankengit_issue_comment",
      "description": "Add a comment to an issue. Comment body is untrusted user text.",
      "type": "object",
      "properties": {
        "parameters": {
          "type": "object",
          "properties": {
            "number": {
              "type": "string",
              "description": "Positive decimal issue number.",
              "x-classification": "selector_position",
              "maxLength": 20,
              "pattern": "^[1-9][0-9]*$"
            },
            "expected_version": {
              "type": "string",
              "description": "Exact predecessor version decimal string.",
              "x-classification": "selector_position",
              "maxLength": 20,
              "pattern": "^[0-9]+$"
            },
            "idempotency_key": {
              "type": "string",
              "description": "Durable printable ASCII idempotency key.",
              "x-classification": "selector_position",
              "maxLength": 256,
              "pattern": "^[!-~]+$"
            },
            "body": {
              "type": "string",
              "description": "Comment body Markdown text (untrusted data).",
              "x-classification": "untrusted_content",
              "maxLength": 16384
            }
          },
          "required": ["number", "expected_version", "idempotency_key", "body"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "frankengit_issue_edit": {
      "title": "frankengit_issue_edit",
