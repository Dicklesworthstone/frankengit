policy update_kind_in
decision deny
subject 0 refs/heads/main non_fast_forward -> deny
  governed-by rewriting
  reason "history rewriting is not allowed"
  consulted rewriting matched deny
subject 1 refs/tags/v1.0.0 create -> allow
  governed-by (default)
  reason (none)
  consulted rewriting unmatched deny
subject 2 refs/heads/stale delete -> deny
  governed-by rewriting
  reason "history rewriting is not allowed"
  consulted rewriting matched deny
